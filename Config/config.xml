<?xml version="1.0" encoding="UTF-8" ?>

<config xmlns="http://thelia.net/schema/dic/config"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/config http://thelia.net/schema/dic/config/thelia-1.0.xsd">

    <services>
        <!--
            Inherits PayPlugModule's payment service (that id is a public alias, which Symfony
            resolves through for child definitions). Kept explicit rather than autowired
            because the parent relationship cannot be expressed with autowiring.
        -->
        <service id="oney_service" class="PayPlugOney\Service\OneyService" parent="payplugmodule_payment_service" public="true">
            <argument type="service" id="event_dispatcher"/>
        </service>
    </services>

    <!--
        No <hooks> nor <forms> section: Thelia 3 auto-discovers both. The back-office hooks
        (Hook/Back/*) declare themselves through getSubscribedHooks(), and ConfigurationForm is
        registered under its getName() by RegisterFormPass, because BaseForm implements
        FormInterface which the kernel autoconfigures.

        The front-office needs no hook at all: the Smarty front-office hooks are gone, so the
        instalment selector comes from the payment module options API
        (EventListener/PaymentOptionListener) and the simulation pop-in from the
        PayPlugOney:OneySimulation LiveComponent.

        Thelia 3 ships Thelia\Core\Hook\Theme\ThemeHookInterface and autoconfigures a
        thelia.theme_hook tag, but NOTHING consumes that tag and no theme_hook() Twig function is
        registered anywhere (core, themes or modules) — the mechanism is inert in this version.
        Hence the API/route based integration.
    -->

</config>
