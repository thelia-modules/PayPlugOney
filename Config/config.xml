<?xml version="1.0" encoding="UTF-8" ?>

<config xmlns="http://thelia.net/schema/dic/config"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/config http://thelia.net/schema/dic/config/thelia-1.0.xsd">

    <forms>
        <form name="payplugoney_configuration_form" class="PayPlugOney\Form\ConfigurationForm" />
    </forms>

    <services>
        <!--
            Inherits PayPlugModule's payment service (that id is a public alias, which Symfony
            resolves through for child definitions). Kept explicit rather than autowired
            because the parent relationship cannot be expressed with autowiring.
        -->
        <service id="oney_service" class="PayPlugOney\Service\OneyService" parent="payplugmodule_payment_service" public="true">
            <argument type="service" id="event_dispatcher"/>
        </service>
    </services>

    <!--
        No <hooks> section: the back-office hooks (Hook/Back/*) declare themselves through
        getSubscribedHooks(), which Thelia 3 auto-discovers. The front-office needs none —
        the Smarty front-office hooks are gone, so the instalment selector comes from the payment
        module options API (EventListener/PaymentOptionListener) and the simulation pop-in from the
        PayPlugOney:OneySimulation LiveComponent. Thelia 3 does offer front-office hooks
        (Thelia\Core\Hook\Theme\ThemeHookInterface + the theme_hook() Twig function), but they
        only fire where the ACTIVE THEME declares a hook point — vallereuil-scierie declares none
        today, hence the API/route based integration.
    -->

</config>
