{# Oney configuration block, inserted into PayPlugModule's configuration screen through the
   payplugmodule.configuration.bottom hook. Rendered as a fragment, so it carries its own
   <form>: PayPlugModule places the hook outside of its own form. #}
{% set d = 'payplugoney.bo.default-twig' %}

<div class="card mb-3" id="oneyConfiguration">
    <div class="card-header d-flex align-items-center gap-2">
        <h2 class="card-title h5 mb-0">{{ 'Multi-payment by Oney'|trans({}, d) }}</h2>
    </div>

    <div class="card-body">
        <form action="{{ path('payplugoney_configuration_save') }}" method="POST">
            <input type="hidden" name="{{ attribute(form, '_token').vars.full_name }}" value="{{ attribute(form, '_token').vars.value }}">
            <input type="hidden" name="{{ form.success_url.vars.full_name }}" value="{{ app.request.uri }}">
            <input type="hidden" name="{{ form.error_url.vars.full_name }}" value="{{ app.request.uri }}">

            {# logo_url is resolved by the hook through the assets resolver, which is what
               actually deploys the file under public/assets/. Empty when resolution fails, in
               which case the block is skipped rather than rendering a broken image. #}
            {% if logo_url is not empty %}
                <div class="mb-4 pb-3 border-bottom">
                    <img style="height: 34px;" src="{{ logo_url }}" alt="Oney" class="img-fluid">
                </div>
            {% endif %}

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" value="1"
                       id="payplugoney-payment-enabled"
                       name="{{ form.payment_enabled.vars.full_name }}"
                       {% if form.payment_enabled.vars.checked %}checked{% endif %}>
                <label class="form-check-label" for="payplugoney-payment-enabled">
                    {{ form.payment_enabled.vars.label }}
                </label>
            </div>

            <div class="mb-3 pb-2 border-bottom">
                <h3 class="h5">{{ 'Terms and Conditions'|trans({}, d) }}</h3>
                <p class="text-muted mb-0">
                    {{ 'You must display the Oney terms and condition either by specify the content you are using to display your terms and conditions or by putting a hook in your page'|trans({}, d) }}
                </p>
            </div>

            <div class="row g-4 align-items-start mb-4">
                <div class="col-md-5">
                    <h4 class="h6">{{ 'By specify content'|trans({}, d) }}</h4>
                    <label class="form-label" for="payplugoney-terms-content">
                        {{ form.terms_and_conditions_content_id.vars.label }}
                    </label>
                    <select class="form-select" id="payplugoney-terms-content"
                            name="{{ form.terms_and_conditions_content_id.vars.full_name }}">
                        {% for choice in form.terms_and_conditions_content_id.vars.choices %}
                            <option value="{{ choice.value }}"
                                    {% if form.terms_and_conditions_content_id.vars.value == choice.value %}selected{% endif %}>
                                {{ choice.label }}
                            </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="col-md-2 text-center pt-4">
                    <span class="h5 text-muted">{{ 'Or'|trans({}, d) }}</span>
                </div>

                <div class="col-md-5">
                    <h4 class="h6">{{ 'By including the Oney terms in your theme'|trans({}, d) }}</h4>
                    <div class="alert alert-info">
                        {# There is no usable front-office hook in Thelia 3, so the theme fetches
                           this route instead — see the module README. #}
                        <p class="mb-1">
                            {{ 'Fetch this route from your theme where your "Terms and Conditions" are displayed:'|trans({}, d) }}
                        </p>
                        <code>{{ path('payplugoney_terms_and_conditions') }}</code>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="1"
                               id="payplugoney-terms-hook-added"
                               name="{{ form.terms_and_conditions_hook_added.vars.full_name }}"
                               {% if form.terms_and_conditions_hook_added.vars.checked %}checked{% endif %}>
                        <label class="form-check-label" for="payplugoney-terms-hook-added">
                            {{ form.terms_and_conditions_hook_added.vars.label }}
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-lg"></i> {{ 'Save'|trans({}, d) }}
                </button>
            </div>
        </form>
    </div>
</div>
